# Optional Google CrUX API key. No key means field data is not requested.
CRUX_API_KEY=
# Store reports and screenshots outside the public directory.
UXBENCH_DATA_DIR=./data

# Optional shared-password gate for a trusted hosted beta. Leave blank locally.
# This does not create separate user workspaces; use it only with people who
# are allowed to see each other's submitted URLs and reports.
UXBENCH_ACCESS_USER=uxbench
UXBENCH_ACCESS_PASSWORD=
